{
  "name": "gitvault",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": { "gitvault": "bin/gitvault.mjs" },
  "engines": { "node": ">=22.16" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "demo:generate": "tsx scripts/generate-demo.ts",
    "cli": "node bin/gitvault.mjs",
    "vault:encrypt": "node bin/gitvault.mjs encrypt"
  },
  "dependencies": {
    "age-encryption": "0.3.1",
    "fflate": "0.8.2",
    "qrcode": "1.5.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.5",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vite": "^6.4.0"
  }
}
